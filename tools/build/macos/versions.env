# Pinned inputs for the macOS ARM64 integration build (PROJECT_SPEC step 4).
# Source this file; it only sets variables.

# llvm-mingw: the PE-side toolchain (x86_64 / aarch64 / arm64ec targets).
# Release 20261006 ships arm64ec-w64-mingw32-{clang,clang++,dlltool,...} (verified by listing
# bin/ of the Linux tarball); SHA-256 values are the release's published asset digests
# (GitHub API: repos/mstorsjo/llvm-mingw/releases, field "digest") and match a local download.
LLVM_MINGW_TAG=20261006
LLVM_MINGW_URL_BASE=https://github.com/mstorsjo/llvm-mingw/releases/download/${LLVM_MINGW_TAG}
LLVM_MINGW_MACOS_FILE=llvm-mingw-${LLVM_MINGW_TAG}-ucrt-macos-universal.tar.xz
LLVM_MINGW_MACOS_SHA256=a7a19b11048e89372637d26279cdb7c430ed3cf8c1e224310421312bf986ebf6
LLVM_MINGW_LINUX_X86_64_FILE=llvm-mingw-${LLVM_MINGW_TAG}-ucrt-ubuntu-22.04-x86_64.tar.xz
LLVM_MINGW_LINUX_X86_64_SHA256=5f9c6ed95b2d4bdb2869a488c5fd5857fbdabcf288a0aa3eb1da43f6a08d8ab4
LLVM_MINGW_LINUX_AARCH64_FILE=llvm-mingw-${LLVM_MINGW_TAG}-ucrt-ubuntu-22.04-aarch64.tar.xz
LLVM_MINGW_LINUX_AARCH64_SHA256=e77c4acfa44184f6b0c52b814d724ad63b2ecebb3c3f6f842c0846e717cbd23c

# Approach (c): the prebuilt "Wine 11.2 ARM64EC" that DXMT's CI links against
# (external/dxmt/.github/workflows/ci.yml:24-25 and 72-79; extracted with --strip-components 2).
# Source: https://github.com/3Shain/wine (master == wine-mirror 78a4aa0f, 2026-02-13, no divergent commits;
# the release was built from something else). Release notes say: "Do not use, it doesn't work (yet) and only
# aims for linking of DXMT." SHA-256 is the digest GitHub publishes for the asset
# (gh api repos/3Shain/wine/releases/tags/wine-11.2 --jq '.assets[].digest'); size 470873339 bytes.
WINE3SHAIN_TAG=wine-11.2
WINE3SHAIN_URL=https://github.com/3Shain/wine/releases/download/wine-11.2/wine-11.2.tar.gz
WINE3SHAIN_SHA256=834ec0d4f1dff94de187f29891dc9938306ea2602d0fff603b407225c916d881

# Wine: external/wine is pinned to MR 11638 head de56343b (DECISIONS D-009). Approach (b), used
# only to separate "MR problem" from "ARM64EC-on-macOS problem", is upstream master:
WINE_UPSTREAM_URL=https://gitlab.winehq.org/wine/wine.git
