+uint64_t
+ResourceInitializer::initWithPackedData(
+    const Texture *texture, TextureAllocation *allocation, uint32_t slice, uint32_t level, const void *data,
+    size_t size, size_t bytes_per_row, size_t bytes_per_image, uint32_t width, uint32_t height, uint32_t depth
+) {
+  bool is_3d_tex = texture->textureType() == WMTTextureType3D;
+
+  std::lock_guard<dxmt::mutex> lock(mutex_);
+  // A real retry loop: when a heap is full the ALLOC_* macros flush and `continue`.
+  for (;;) {
+    RETAIN(allocation);
+    ALLOC_GPU(temp, size);
+    temp.updateContents(temp_offset, data, size);
+    // last: the command is linked into the blit list as soon as it is allocated
+    ALLOC_BLIT(wmtcmd_blit_copy_from_buffer_to_texture, copy);
+
+    copy->type = WMTBlitCommandCopyFromBufferToTexture;
+    copy->src = temp;
+    copy->src_offset = temp_offset;
+    copy->bytes_per_row = bytes_per_row;
+    copy->bytes_per_image = is_3d_tex ? bytes_per_image : 0;
+    copy->size = {width, height, depth};
+    copy->dst = allocation->texture();
+    copy->slice = slice;
+    copy->level = level;
+    copy->origin = {0, 0, 0};
+    break;
+  }
+
+  return current_seq_id_;
+}
