+/**
+BC on a device without BC support (dxmt_bc_emulation.hpp): decode the application's blocks and
+replaceRegion() the pixels of the substitute format instead. Returns false (and does nothing)
+when `format` is not an emulated BC format.
+*/
+static bool
+InitializeEmulatedBCTextureData(
+    MTLD3D11Device *pDevice, WMT::Texture target, DXGI_FORMAT format, uint32_t width, uint32_t height, uint32_t depth,
+    uint32_t mips, uint32_t slices, const D3D11_SUBRESOURCE_DATA *subresources
+) {
+  MTL_DXGI_FORMAT_DESC format_desc;
+  if (FAILED(MTLQueryDXGIFormat(pDevice->GetMTLDevice(), format, format_desc)) ||
+      !(format_desc.Flag & MTL_DXGI_FORMAT_EMULATED_BC))
+    return false;
+  auto info = bc::GetFormatInfo(format);
+  for (uint32_t level = 0; level < mips; level++) {
+    uint32_t w = std::max(1u, width >> level), h = std::max(1u, height >> level), d = std::max(1u, depth >> level);
+    uint32_t cols = bc::BlocksOf(w), rows = bc::BlocksOf(h);
+    size_t row_bytes = size_t(cols) * info->block_bytes;
+    for (uint32_t slice = 0; slice < slices; slice++) {
+      auto &src = subresources[D3D11CalcSubresource(level, slice, mips)];
+      size_t src_row = src.SysMemPitch ? std::max<size_t>(src.SysMemPitch, row_bytes) : row_bytes;
+      size_t src_slice = src.SysMemSlicePitch ? src.SysMemSlicePitch : src_row * rows;
+      std::vector<uint8_t> blocks(row_bytes * rows * d), pixels;
+      bc::CopyBlocks(
+          blocks.data(), row_bytes, row_bytes * rows, static_cast<const uint8_t *>(src.pSysMem), src_row, src_slice,
+          info->block_bytes, cols, rows, d
+      );
+      if (!bc::Decode(*info, w, h, d, blocks.data(), pixels))
+        continue;
+      target.replaceRegion(
+          {0, 0, 0}, {w, h, d}, level, slice, pixels.data(), size_t(w) * info->decoded_bytes,
+          size_t(w) * h * info->decoded_bytes
+      );
+    }
+  }
+  return true;
+}
