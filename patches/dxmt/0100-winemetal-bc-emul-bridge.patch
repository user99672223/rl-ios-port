+if fs.is_file('rltex/rltex.h') and fs.is_file('rltex/bcdec.h')
+  rltex_lib = static_library('rltex', [
+      'rltex/sha256.c', 'rltex/format.c', 'rltex/bc_decode.c', 'rltex/config.c',
+      'rltex/fs.c', 'rltex/astc_encode.c', 'rltex/ctx.c', 'rltex/platform.c',
+    ],
+    include_directories : include_directories('rltex'),
+    native              : true,
+    pic                 : true,
+  )
+  bc_unix_c_args += ['-DDXMT_BC_WITH_RLTEX=1', '-I' + meson.current_source_dir() / 'rltex']
+  bc_unix_link_with += [rltex_lib]
+endif
+
 if wine_build_path != ''
   winemac_so = join_paths(wine_build_path, 'dlls/winemac.drv/winemac.so')
   ntdll_so = join_paths(wine_build_path, 'dlls/ntdll/ntdll.so')
@@ -28,7 +48,8 @@ shared_library('winemetal', winemetal_unix_src,
   name_prefix         : '',
   dependencies        : [ airconv_dep_darwin ],
   include_directories : dxmt_include_path,
-  c_args              : ['-ObjC'],
+  c_args              : ['-ObjC'] + bc_unix_c_args,
