diff --git a/src/winemetal/unix/bc_emul.c b/src/winemetal/unix/bc_emul.c
new file mode 100644
index 0000000..09cabc8
--- /dev/null
+++ b/src/winemetal/unix/bc_emul.c
@@ -0,0 +1,196 @@
+/*
+ * BC texture emulation bridge: unix side (patches/dxmt/0100).
+ *
+ * Metal devices without BC support (Apple GPUs before the M1 family on iOS: A16 and friends)
+ * cannot sample BC1-BC7. The PE side (d3d11.dll) keeps D3D11's BC semantics and calls this
+ * file, through unix calls 132 / 133, for every surface of BC blocks it has to turn into
+ * something Metal can sample. This file is a thin adapter over the project's texture library
+ * (runtime/textures, `rltex`, contract in docs/notes/textures.md):
+ *
+ *   rltex_acquire()    key = SHA-256(header || blob); ASTC cache hit -> payload;
+ *                      miss -> bcdec decode, save <key>.bc once, append the miss log
+ *   rltex_bc_decode()  plain decode (UpdateSubresource, Map/Unmap, copies: no cache, no key)
+ *
+ * Environment (unix side, i.e. the environment `wine` was started with):
+ *   DXMT_BC_CACHE_DIR   rltex "documents root" (<root>/cache/textures/<key>.astc ...). Unset =
+ *                       cache off: everything is decoded, nothing is saved or logged.
+ *   DXMT_BC_CONFIG      optional port.toml subset parsed by rltex_config_load_file()
+ *                       (astc_bc*_block, astc_bc6h_mode)
+ *   DXMT_BC_LOG=1       one stderr line per cache lookup (HIT / MISS) for CI logs
+ *
+ * Without rltex sources staged next to this file (see src/winemetal/unix/meson.build) the
+ * file compiles to stubs and WMTBCEmulQuery() reports "not available"; DXMT then behaves
+ * exactly as before the patch (BC formats not advertised on devices without BC support).
+ */
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define WINEMETAL_API
+#include "../winemetal_thunks.h"
+
+typedef int NTSTATUS;
+#define STATUS_SUCCESS 0
+
+#ifdef DXMT_BC_WITH_RLTEX
+#include "rltex.h"
+
+static pthread_once_t g_once = PTHREAD_ONCE_INIT;
+static rltex_ctx *g_ctx;
+static rltex_config g_cfg;
+static int g_log;
+
+static void
+bc_emul_init(void) {
+  rltex_config *cfg_p = &g_cfg;
+  const char *root = getenv("DXMT_BC_CACHE_DIR");
+  const char *conf = getenv("DXMT_BC_CONFIG");
+  const char *log = getenv("DXMT_BC_LOG");
+  g_log = log && log[0] == '1';
+
+  rltex_config_defaults(cfg_p);
+  /* BC6H -> ASTC HDR needs MTLPixelFormatASTC_*_HDR; availability on the A16 is not confirmed
+     (docs/notes/textures.md section 3). Default to the decoded RGBA16F upload, a config file
+     with `astc_bc6h_mode = "astc_hdr"` opts in. */
+  cfg_p->bc6h_astc_hdr = 0;
+  if (conf && conf[0]) {
+    char err[512] = {0};
+    int bad = rltex_config_load_file(cfg_p, conf, err, sizeof err);
+    if (bad < 0)
+      fprintf(stderr, "bc-emul: cannot read %s: %s\n", conf, rltex_status_string(bad));
+    else if (bad)
+      fprintf(stderr, "bc-emul: %d invalid value(s) in %s:\n%s\n", bad, conf, err);
+  }
+  /* No astc-encoder linked in here: the library would ignore this anyway. The offline
+     encoder (tools/textures/encode.py) is what turns saved .bc blobs into .astc files. */
+  cfg_p->background_encode = 0;
+
+  if (root && root[0]) {
+    int r = rltex_ctx_create(root, cfg_p, &g_ctx);
+    if (r != RLTEX_OK) {
+      fprintf(stderr, "bc-emul: cache disabled, rltex_ctx_create(%s) failed: %s\n", root, rltex_status_string(r));
+      g_ctx = NULL;
+    } else if (g_log) {
+      fprintf(stderr, "bc-emul: cache root %s\n", root);
+    }
+  }
+}
+
+NTSTATUS
+bc_emul_query(void *obj) {
+  struct unixcall_generic_obj_uint64_ret *params = obj;
+  pthread_once(&g_once, bc_emul_init);
+  params->ret = WMT_BCEMUL_AVAILABLE | (g_ctx ? WMT_BCEMUL_CACHE_ON : 0);
+  return STATUS_SUCCESS;
+}
+
+static void
+copy_swizzle(char dst[8], const char *src) {
+  memset(dst, 0, 8);
+  if (src)
+    strncpy(dst, src, 7);
+}
+
+NTSTATUS
+bc_emul_acquire(void *obj) {
+  struct unixcall_generic_obj_ptr_noret *params = obj;
+  struct WMTBCEmulInfo *info = params->arg.ptr;
+  rltex_desc desc;
+  pthread_once(&g_once, bc_emul_init);
+
+  info->status = RLTEX_E_ARG;
+  info->source = WMTBCEmulSourceNone;
+  info->out_size = 0;
+  info->key[0] = 0;
+  copy_swizzle(info->view_swizzle, "rgba");
+  if (!info->blob.ptr || !info->out.ptr)
+    return STATUS_SUCCESS;
+
+  desc.dxgi_format = info->dxgi_format;
+  desc.width = info->width;
+  desc.height = info->height;
+  desc.mip_level = info->mip_level;
+  desc.array_slice = info->array_slice;
+
+  if ((info->flags & WMT_BCEMUL_USE_CACHE) && g_ctx) {
+    rltex_tex tex;
+    int r = rltex_acquire(g_ctx, &desc, info->blob.ptr, (size_t)info->blob_size, &tex);
+    info->status = r;
+    if (r != RLTEX_OK)
+      return STATUS_SUCCESS;
+    strncpy(info->key, tex.key, sizeof info->key - 1);
+    info->key[sizeof info->key - 1] = 0;
+    if (tex.source == RLTEX_SRC_ASTC_CACHE) {
+      if (tex.astc_size > info->out_capacity) {
+        info->status = RLTEX_E_SIZE;
+      } else {
+        memcpy(info->out.ptr, tex.astc_data, tex.astc_size);
+        info->out_size = tex.astc_size;
+        info->source = WMTBCEmulSourceAstc;
+        info->astc_block_x = tex.astc_block_x;
+        info->astc_block_y = tex.astc_block_y;
+        info->astc_profile = (uint32_t)tex.astc_profile;
+        copy_swizzle(info->view_swizzle, tex.view_swizzle);
+      }
+    } else if (tex.pixels_size > info->out_capacity) {
+      info->status = RLTEX_E_SIZE;
+    } else {
+      memcpy(info->out.ptr, tex.pixels, tex.pixels_size);
+      info->out_size = tex.pixels_size;
+      info->source = WMTBCEmulSourceDecoded;
+      info->pixfmt = (uint32_t)tex.pixfmt;
+    }
+    if (g_log) {
+      /* HIT: ASTC from the cache. MISS: decoded, .bc blob saved and miss logged (once per key and
+         process). NOASTC: this format has no ASTC mapping (SNORM, BC6H unless configured), decoded
+         without touching the cache files. */
+      rltex_bc_info bi;
+      rltex_astc_params ap;
+      const char *what = "NOASTC";
+      if (info->source == WMTBCEmulSourceAstc)
+        what = "HIT";
+      else if (rltex_bc_info_for_dxgi(desc.dxgi_format, &bi) == RLTEX_OK && rltex_astc_params_for(&g_cfg, &bi, &ap) == RLTEX_OK)
+        what = "MISS";
+      fprintf(
+          stderr, "bc-emul: %s key=%s dxgi=%u %ux%u mip=%u slice=%u\n", what, tex.key, desc.dxgi_format, desc.width,
+          desc.height, desc.mip_level, desc.array_slice
+      );
+    }
+    rltex_tex_release(&tex);
+    return STATUS_SUCCESS;
+  }
+
+  {
+    rltex_pixfmt pf = (rltex_pixfmt)0;
+    int r = rltex_bc_decode(&desc, info->blob.ptr, (size_t)info->blob_size, info->out.ptr, (size_t)info->out_capacity, &pf);
+    info->status = r;
+    if (r == RLTEX_OK) {
+      size_t n = (size_t)desc.width * desc.height * rltex_pixfmt_bytes(pf);
+      info->out_size = n;
+      info->source = WMTBCEmulSourceDecoded;
+      info->pixfmt = (uint32_t)pf;
+    }
+  }
+  return STATUS_SUCCESS;
+}
+
+#else /* !DXMT_BC_WITH_RLTEX */
+
+NTSTATUS
+bc_emul_query(void *obj) {
+  struct unixcall_generic_obj_uint64_ret *params = obj;
+  params->ret = 0;
+  return STATUS_SUCCESS;
+}
+
+NTSTATUS
+bc_emul_acquire(void *obj) {
+  struct unixcall_generic_obj_ptr_noret *params = obj;
+  struct WMTBCEmulInfo *info = params->arg.ptr;
+  info->status = -8; /* RLTEX_E_UNSUPPORTED */
+  info->source = WMTBCEmulSourceNone;
+  return STATUS_SUCCESS;
+}
+
+#endif
