@@ -1,8 +1,28 @@
 winemetal_unix_src = [
   'winemetal_unix.c',
   'cache.c',
+  'bc_emul.c',
 ]
 
+# BC texture emulation (patches/dxmt/0100): bc_emul.c wraps the project's rltex library.
+# The sources are staged here by tests/d3d11/bc_textures/stage_rltex.sh (rltex.h, src/*.c from
+# runtime/textures, bcdec.h from external/bcdec). Not staged: bc_emul.c builds to stubs and
