diff --git a/src/winemetal/winemetal.h b/src/winemetal/winemetal.h
index 92740e3..cc8fd61 100644
--- a/src/winemetal/winemetal.h
+++ b/src/winemetal/winemetal.h
@@ -448,9 +448,13 @@ enum WMTPixelFormat : uint32_t {
 
   WMTPixelFormatGBARSwizzle = 0x00100000,
 
+  /* BC5 sampled from an ASTC texture whose encoder swizzle was rrrg: view (r, a, 0, 1).
+     (BC emulation, patches/dxmt/0100; docs/notes/textures.md "BC4/BC5 rrr1/rrrg"). */
+  WMTPixelFormatRA01Swizzle = 0x00080000,
+
   WMTPixelFormatBGRA4Unorm = WMTPixelFormatGBARSwizzle | WMTPixelFormatABGR4Unorm,
 
-  WMTPixelFormatCustomSwizzle = WMTPixelFormatRGB1Swizzle | WMTPixelFormatR001Swizzle | WMTPixelFormat0R01Swizzle | WMTPixelFormatGBARSwizzle,
+  WMTPixelFormatCustomSwizzle = WMTPixelFormatRGB1Swizzle | WMTPixelFormatR001Swizzle | WMTPixelFormat0R01Swizzle | WMTPixelFormatGBARSwizzle | WMTPixelFormatRA01Swizzle,
 };
 
 #define ORIGINAL_FORMAT(format) (format & ~WMTPixelFormatCustomSwizzle)
@@ -1924,4 +1928,47 @@ WINEMETAL_API obj_handle_t MTLDevice_newTileRenderPipelineState(
     obj_handle_t device, const struct WMTTileRenderPipelineInfo *info, obj_handle_t *err_out
 );
 
+/*
+ * BC texture emulation bridge (patches/dxmt/0100). Implemented in unix/bc_emul.c on top of the
+ * project's rltex library (runtime/textures): bcdec decode, ASTC cache lookup by content key,
+ * `.bc` blob save and miss log.
+ */
+#define WMT_BCEMUL_AVAILABLE 1u /* WMTBCEmulQuery: unix side was built with rltex */
+#define WMT_BCEMUL_CACHE_ON 2u  /* WMTBCEmulQuery: DXMT_BC_CACHE_DIR is set and usable */
+
+#define WMT_BCEMUL_USE_CACHE 1u /* WMTBCEmulInfo.flags: key lookup / blob save / miss log */
+
+enum WMTBCEmulSource : uint32_t {
+  WMTBCEmulSourceNone = 0,
+  WMTBCEmulSourceDecoded = 1, /* out = tightly packed pixels, `pixfmt` = rltex_pixfmt */
+  WMTBCEmulSourceAstc = 2,    /* out = ASTC payload (16 bytes per block, no file header) */
+};
+
+struct WMTBCEmulInfo {
+  struct WMTConstMemoryPointer blob; // in: tightly packed BC blocks of one 2D surface
+  struct WMTMemoryPointer out;       // in: result buffer
+  uint64_t blob_size;                // in
+  uint64_t out_capacity;             // in
+  uint64_t out_size;                 // out
+  uint32_t dxgi_format;              // in: BC DXGI_FORMAT (TYPELESS accepted)
+  uint32_t width;                    // in: texel size of THIS mip level (or region)
+  uint32_t height;                   // in
+  uint32_t mip_level;                // in: key material
+  uint32_t array_slice;              // in: key material
+  uint32_t flags;                    // in: WMT_BCEMUL_*
+  int32_t status;                    // out: rltex status (0 = ok)
+  uint32_t source;                   // out: WMTBCEmulSource
+  uint32_t pixfmt;                   // out: rltex_pixfmt of decoded data
+  uint32_t astc_block_x;             // out
+  uint32_t astc_block_y;             // out
+  uint32_t astc_profile;             // out: rltex_astc_profile (0 LDR, 1 LDR sRGB, 2 HDR)
+  char view_swizzle[8];              // out: "rgba", "r001" or "ra01"
+  char key[72];                      // out: 64 hex chars
+};
+
+STATIC_ASSERT(sizeof(WMTBCEmulInfo) == 168);
+
+WINEMETAL_API uint32_t WMTBCEmulQuery(void);
+WINEMETAL_API void WMTBCEmulAcquire(struct WMTBCEmulInfo *info);
+
 #endif
\ No newline at end of file
diff --git a/src/winemetal/winemetal_thunks.c b/src/winemetal/winemetal_thunks.c
index af3166e..ceadc52 100644
--- a/src/winemetal/winemetal_thunks.c
+++ b/src/winemetal/winemetal_thunks.c
@@ -1179,3 +1179,20 @@ MTLDevice_newTileRenderPipelineState(
     *err_out = params.ret_error;
   return params.ret_pso;
 }
+
+WINEMETAL_API uint32_t
+WMTBCEmulQuery(void) {
+  struct unixcall_generic_obj_uint64_ret params;
+  params.handle = 0;
+  params.ret = 0;
+  UNIX_CALL(132, &params);
+  return (uint32_t)params.ret;
+}
+
+WINEMETAL_API void
+WMTBCEmulAcquire(struct WMTBCEmulInfo *info) {
+  struct unixcall_generic_obj_ptr_noret params;
+  params.handle = 0;
+  WMT_MEMPTR_SET(params.arg, info);
+  UNIX_CALL(133, &params);
+}
