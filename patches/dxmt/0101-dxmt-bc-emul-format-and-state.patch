+#pragma once
+/*
+ * BC1-BC7 texture emulation for Metal devices without BC support (patches/dxmt/0100).
+ *
+ * The D3D11 side keeps BC semantics (block layouts for initial data, UpdateSubresource,
+ * Map/Unmap, staging copies). The Metal texture behind a BC texture is a substitute format the
+ * device can sample: RGBA8 (sRGB where applicable) for BC1/2/3/7, R8 / RG8 (UNORM or SNORM)
+ * for BC4 / BC5, RGBA16Float for BC6H - exactly what the project's texture library (rltex,
+ * docs/notes/textures.md section 3) decodes to - or, when the ASTC cache has every
+ * subresource of a texture, an ASTC texture of the cached block size.
+ *
+ * Decoding and the cache live on the unix side (src/winemetal/unix/bc_emul.c, unix calls
+ * WMTBCEmulQuery / WMTBCEmulAcquire); this header is the PE-side interface.
+ *
+ * Switches (environment of the process):
+ *   DXMT_DEBUG_FORCE_NO_BC=1  behave as if MTLDevice.supportsBCTextureCompression were false
+ *   DXMT_BC_CACHE_DIR=<dir>   rltex documents root (unix side); unset = no ASTC cache
+ *   DXMT_BC_CONFIG=<file>     rltex port.toml subset (ASTC block sizes)
+ *   DXMT_BC_SHADOW=1          keep the original blocks of DEFAULT / IMMUTABLE BC textures so
+ *                             they can be copied back to a STAGING BC texture. ASTC-backed
+ *                             textures always keep them (they cannot be decoded back).
+ *   DXMT_BC_ASTC_DEFAULT=0    only IMMUTABLE textures may be ASTC-backed (default: also DEFAULT
+ *                             textures that are shader-resource-only)
+ *   DXMT_BC_LOG=1             unix side: one stderr line per cache lookup
+ */
+#include "Metal.hpp"
+#include "dxgi.h"
+#include "thread.hpp"
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+namespace dxmt {
+namespace bc {
+
+enum class Kind : uint32_t { BC1 = 1, BC2, BC3, BC4, BC5, BC6H, BC7 }; /* == rltex_bc_kind */
+
+struct FormatInfo {
+  DXGI_FORMAT format;          /* canonical DXGI format (TYPELESS maps to UNORM / UF16) */
+  Kind kind;
+  bool srgb;
+  bool is_signed;              /* BC4/BC5 SNORM, BC6H SF16 */
+  uint32_t block_bytes;        /* 8 or 16 */
+  WMTPixelFormat bc_format;    /* the native Metal BC format */
+  WMTPixelFormat decoded;      /* substitute Metal format (rltex decode target) */
+  uint32_t decoded_bytes;      /* bytes per texel of `decoded` */
+};
+
+/** nullptr when `format` is not one of the BC1-BC7 DXGI formats (TYPELESS included). */
+const FormatInfo *GetFormatInfo(DXGI_FORMAT format);
+
+/** MTLDevice.supportsBCTextureCompression, or false under DXMT_DEBUG_FORCE_NO_BC=1. */
+bool DeviceSupportsBC(WMT::Device device);
+
+/** True when BC formats must be emulated: the device (as seen above) lacks BC and the unix
+    side was built with rltex. Evaluated once per process (single GPU). */
+bool EmulationActive(WMT::Device device);
+
+/** The unix side has a usable ASTC cache root (DXMT_BC_CACHE_DIR). */
+bool CacheEnabled();
+
+inline uint32_t
+BlocksOf(uint32_t texels) {
+  return (texels + 3u) >> 2;
+}
+
+/** Copy a cols x rows x depth rectangle of blocks between two block arrays. */
+void CopyBlocks(
+    uint8_t *dst, size_t dst_row_pitch, size_t dst_slice_pitch, const uint8_t *src, size_t src_row_pitch,
+    size_t src_slice_pitch, uint32_t block_bytes, uint32_t cols, uint32_t rows, uint32_t depth
+);
+
+/**
+ * Decode tightly packed blocks (BlocksOf(w) x BlocksOf(h) per depth slice) to the substitute
+ * format: `w * h * d * decoded_bytes` bytes, tight rows, cropped to w x h. No cache, no key.
+ */
+bool Decode(const FormatInfo &info, uint32_t w, uint32_t h, uint32_t d, const uint8_t *blocks, std::vector<uint8_t> &out);
+
+/** Result of a cache-aware lookup of one whole 2D surface (initial data). */
+struct Surface {
+  bool astc = false;
+  std::vector<uint8_t> data; /* decoded pixels (tight rows) or ASTC payload */
+  uint32_t block_x = 0;
+  uint32_t block_y = 0;
+  uint32_t profile = 0;      /* rltex_astc_profile: 0 LDR, 1 LDR sRGB, 2 HDR */
+  char swizzle[8] = {};
+};
+
+/** rltex_acquire: ASTC hit -> payload; miss -> decoded pixels + .bc saved + miss log. */
+bool Acquire(
+    const FormatInfo &info, DXGI_FORMAT dxgi, uint32_t w, uint32_t h, uint32_t mip, uint32_t slice,
+    const uint8_t *blocks, Surface &out
+);
+
+/** Metal ASTC format for a block size + profile (0 LDR, 1 LDR sRGB, 2 HDR); Invalid if illegal. */
+WMTPixelFormat AstcPixelFormat(uint32_t block_x, uint32_t block_y, uint32_t profile);
+
+struct Region {
+  uint32_t x, y, z; /* texels; x and y multiples of 4 for BC */
+  uint32_t w, h, d;
+};
+
+/**
+ * Emulation state of one D3D11 texture (DEFAULT / IMMUTABLE / DYNAMIC): which Metal format
+ * backs it, and the optional CPU copy of the original blocks.
+ */
+class TextureState {
+public:
+  TextureState(
+      const FormatInfo &info, uint32_t width, uint32_t height, uint32_t depth, uint32_t mip_levels,
+      uint32_t array_slices, bool keep_shadow
+  );
+
+  const FormatInfo &
+  format() const {
+    return info_;
+  }
+
+  /* ---- Metal backing ------------------------------------------------------------------ */
+  /** Back the texture with ASTC (`ldr` = the LDR / HDR format, `srgb` = its sRGB sibling or
+      Invalid) and apply `swizzle` ("rgba", "r001", "ra01") to every view. */
+  void setAstc(WMTPixelFormat ldr, WMTPixelFormat srgb, const char *swizzle);
+  bool
+  isAstc() const {
+    return astc_;
+  }
+  /** Maps a view format requested in terms of the substitute format to the format of the
+      actual Metal texture (identity unless ASTC-backed). */
+  WMTPixelFormat mapViewFormat(WMTPixelFormat requested) const;
+
+  /* ---- geometry ------------------------------------------------------------------------ */
+  uint32_t
+  mipLevels() const {
+    return mips_;
+  }
+  void mipSize(uint32_t mip, uint32_t &w, uint32_t &h, uint32_t &d) const;
+
+  /* ---- shadow copy of the original blocks --------------------------------------------- */
+  bool
+  shadowEnabled() const {
+    return keep_shadow_;
+  }
+  /** Replace a whole subresource (tight blocks, depth-major). */
+  void shadowStoreSubresource(uint32_t sub, std::vector<uint8_t> &&blocks);
+  /** Store a region given as tight blocks (BlocksOf(w) x BlocksOf(h) x d). */
+  void shadowStoreRegion(uint32_t sub, uint32_t mip, const Region &r, const uint8_t *blocks);
+  /** Load a region as tight blocks. False if the shadow is unknown (never kept / invalidated). */
+  bool shadowLoadRegion(uint32_t sub, uint32_t mip, const Region &r, uint8_t *blocks_out);
+  /** The shadow of `sub` no longer matches the texture (copy from a source without shadow). */
+  void shadowInvalidate(uint32_t sub);
+
+private:
+  enum : uint8_t { Zero = 0, Valid = 1, Unknown = 2 };
+  const FormatInfo &info_;
+  uint32_t width_, height_, depth_, mips_, slices_;
+  bool keep_shadow_;
+  bool astc_ = false;
+  WMTPixelFormat astc_ldr_ = WMTPixelFormatInvalid;
+  WMTPixelFormat astc_srgb_ = WMTPixelFormatInvalid;
+  uint32_t swizzle_flag_ = 0;
+  dxmt::mutex mutex_;
+  std::vector<std::vector<uint8_t>> shadow_;
+  std::vector<uint8_t> shadow_state_;
+};
+
+/** D3D11_SUBRESOURCE_DATA, without the d3d11 headers. */
+struct InitialSubresource {
+  const void *data;
+  uint32_t row_pitch;
+  uint32_t slice_pitch;
+};
+
+/** One subresource of the initial data, prepared for upload. */
+struct PreparedSubresource {
+  std::vector<uint8_t> blocks; /* original blocks, tight (kept as the shadow) */
+  std::vector<uint8_t> data;   /* decoded pixels or ASTC payload */
+  bool astc = false;
+  uint32_t width = 0, height = 0, depth = 1;
+  uint32_t bytes_per_row = 0;
+  uint32_t bytes_per_image = 0;
+  uint32_t block_x = 0, block_y = 0, profile = 0;
+  char swizzle[8] = {};
+};
+
+/**
+ * Gather the initial data of every subresource (D3D11 pitches -> tight blocks) and decode it,
+ * consulting the ASTC cache when `allow_astc`. If every subresource hits the cache with one
+ * block size / profile / swizzle the result is ASTC-backed (`state` is switched with
+ * TextureState::setAstc and `*astc_base` receives the Metal format); otherwise any cache hit
+ * is decoded from the blocks and the result is decoded-backed.
+ */
+bool PrepareInitialData(
+    const FormatInfo &info, TextureState &state, uint32_t width, uint32_t height, uint32_t depth, uint32_t mips,
+    uint32_t slices, const InitialSubresource *initial_data, bool allow_astc, std::vector<PreparedSubresource> &out,
+    WMTPixelFormat *astc_base
+);
+
+/** DXMT_BC_ASTC_DEFAULT (default on): DEFAULT-usage textures may be ASTC-backed too. */
+bool AstcDefaultUsageAllowed();
+
+/** DXMT_BC_SHADOW=1. */
+bool ShadowRequested();
+
+} // namespace bc
+} // namespace dxmt
