From bf2dcc264ea8f96132512c34fcc44c2276930258 Mon Sep 17 00:00:00 2001
From: rl-ios-port <noreply@anthropic.com>
Date: Thu, 29 Oct 2026 10:48:08 +0100
Subject: [PATCH] ARM64EC: read the TEB from Darwin TSD slot 6 when x18 is not
 preserved

With FEX_TEB_IN_DARWIN_TSD (Wine on Apple ARM64), JIT-emitted TEB loads, Module.S
and the ARM64EC module's C++ read the TEB from pthread TSD slot 6
(TPIDRRO_EL0 + 0x30), which Wine keeps current per thread, instead of x18, which
the Darwin kernel does not preserve. Stock builds are unchanged.

Local patch for a private port; not for upstream submission (see DECISIONS D-008).
---
 .../Interface/Core/ArchHelpers/Arm64Emitter.h | 13 +++++++++
 .../Interface/Core/Dispatcher/Dispatcher.cpp  |  6 ++--
 FEXCore/Source/Interface/Core/JIT/MiscOps.cpp |  4 +--
 Source/Windows/ARM64EC/Module.S               | 28 +++++++++++++++----
 Source/Windows/ARM64EC/Module.cpp             |  7 +++--
 Source/Windows/Common/CRT/Misc.cpp            |  3 +-
 Source/Windows/Common/CurrentTEB.h            | 16 +++++++++++
 Source/Windows/Common/Priv.h                  |  3 +-
 8 files changed, 65 insertions(+), 15 deletions(-)
 create mode 100644 Source/Windows/Common/CurrentTEB.h

diff --git a/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.h b/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.h
index 23645b2..4f665d9 100644
--- a/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.h
+++ b/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.h
@@ -119,6 +119,19 @@ public:
   };
   void LoadConstant(ARMEmitter::Size s, ARMEmitter::Register Reg, uint64_t Constant, PadType Pad = PadType::NOPAD, int MaxBytes = 0);
 
+  // Load the 64-bit value at TEB + Offset into Reg (ARM64EC). Normally the TEB is x18. With
+  // FEX_TEB_IN_DARWIN_TSD (Wine on Apple ARM64, where the kernel does not preserve x18) it is read
+  // from pthread TSD slot 6 (TPIDRRO_EL0 + 0x30), which Wine keeps current for every thread.
+  void LoadFromTEB(ARMEmitter::XRegister Reg, size_t Offset) {
+#ifdef FEX_TEB_IN_DARWIN_TSD
+    mrs(Reg, ARMEmitter::SystemRegister::TPIDRRO_EL0);
+    ldr(Reg, Reg, 0x30);
+    ldr(Reg, Reg, Offset);
+#else
+    ldr(Reg, ARMEmitter::XReg::x18, Offset);
+#endif
+  }
+
 protected:
   FEXCore::Context::ContextImpl* EmitterCTX;
 
diff --git a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
index bde2e3b..8b68afa 100644
--- a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
@@ -157,7 +157,7 @@ void Dispatcher::EmitDispatcher() {
   // Clobbers TMP1/2
   // Check the EC code bitmap incase we need to exit the JIT to call into native code.
   ARMEmitter::ForwardLabel l_NotECCode;
-  ldr(TMP1, ARMEmitter::XReg::x18, TEB_PEB_OFFSET);
+  LoadFromTEB(TMP1, TEB_PEB_OFFSET);
   ldr(TMP1, TMP1, PEB_EC_CODE_BITMAP_OFFSET);
 
   lsr(ARMEmitter::Size::i64Bit, TMP2, RipReg, 18);
@@ -265,7 +265,7 @@ void Dispatcher::EmitDispatcher() {
 #endif
 
 #ifdef ARCHITECTURE_arm64ec
-    ldr(TMP2, ARMEmitter::XReg::x18, TEB_CPU_AREA_OFFSET);
+    LoadFromTEB(TMP2, TEB_CPU_AREA_OFFSET);
     LoadConstant(ARMEmitter::Size::i32Bit, TMP1, 1);
     strb(TMP1.W(), TMP2, CPU_AREA_IN_SYSCALL_CALLBACK_OFFSET);
 #endif
@@ -273,7 +273,7 @@ void Dispatcher::EmitDispatcher() {
     Body();
 
 #ifdef ARCHITECTURE_arm64ec
-    ldr(TMP2, ARMEmitter::XReg::x18, TEB_CPU_AREA_OFFSET);
+    LoadFromTEB(TMP2, TEB_CPU_AREA_OFFSET);
     strb(ARMEmitter::WReg::zr, TMP2, CPU_AREA_IN_SYSCALL_CALLBACK_OFFSET);
 #endif
 
diff --git a/FEXCore/Source/Interface/Core/JIT/MiscOps.cpp b/FEXCore/Source/Interface/Core/JIT/MiscOps.cpp
index 6e8df95..4b0d084 100644
--- a/FEXCore/Source/Interface/Core/JIT/MiscOps.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/MiscOps.cpp
@@ -366,7 +366,7 @@ DEF_OP(MonoBackpatcherWrite) {
   }
 
 #ifdef ARCHITECTURE_arm64ec
-  ldr(TMP2, ARMEmitter::XReg::x18, TEB_CPU_AREA_OFFSET);
+  LoadFromTEB(TMP2, TEB_CPU_AREA_OFFSET);
   LoadConstant(ARMEmitter::Size::i32Bit, TMP1, 1);
   strb(TMP1.W(), TMP2, CPU_AREA_IN_SYSCALL_CALLBACK_OFFSET);
 #endif
@@ -379,7 +379,7 @@ DEF_OP(MonoBackpatcherWrite) {
   }
 
 #ifdef ARCHITECTURE_arm64ec
-  ldr(TMP2, ARMEmitter::XReg::x18, TEB_CPU_AREA_OFFSET);
+  LoadFromTEB(TMP2, TEB_CPU_AREA_OFFSET);
   strb(ARMEmitter::WReg::zr, TMP2, CPU_AREA_IN_SYSCALL_CALLBACK_OFFSET);
 #endif
 
diff --git a/Source/Windows/ARM64EC/Module.S b/Source/Windows/ARM64EC/Module.S
index 2489e65..4bc2c46 100644
--- a/Source/Windows/ARM64EC/Module.S
+++ b/Source/Windows/ARM64EC/Module.S
@@ -1,3 +1,16 @@
+// LOAD_TEB reg: the current TEB. Normally x18; with FEX_TEB_IN_DARWIN_TSD (Wine on Apple ARM64,
+// where the kernel does not preserve x18) pthread TSD slot 6 (TPIDRRO_EL0 + 0x30).
+#ifdef FEX_TEB_IN_DARWIN_TSD
+.macro LOAD_TEB reg
+  mrs \reg, tpidrro_el0
+  ldr \reg, [\reg, #0x30]
+.endm
+#else
+.macro LOAD_TEB reg
+  mov \reg, x18
+.endm
+#endif
+
 .text
 .balign 16
 
@@ -16,7 +29,8 @@ RetToEntryThunk:
 
 check_target_ec:
   // Check if target is in fact x86 code
-  ldr x16, [x18, #0x60] // TEB->PEB
+  LOAD_TEB x16
+  ldr x16, [x16, #0x60] // TEB->PEB
   ldr x16, [x16, #0x368] // PEB->EcCodeBitMap
   lsr x17, x9, #18
   ldr x16, [x16, x17, lsl #3]
@@ -32,7 +46,8 @@ ExitToX64:
   str lr, [sp, #-8]! // Push return address to stack, this will be popped by the x86 RET instr.
 
 enter_jit:
-  ldr x17, [x18, #0x1788] // TEB->ChpeV2CpuAreaInfo
+  LOAD_TEB x17
+  ldr x17, [x17, #0x1788] // TEB->ChpeV2CpuAreaInfo
   mov w16, #1
   strb w16, [x17, #0x0] // ChpeV2CpuAreaInfo->InSimulation
   ldr x16, [x17, #0x40] // ChpeV2CpuAreaInfo->EmulatorData[2] - DispatcherLoopTopEnterEC
@@ -41,12 +56,14 @@ enter_jit:
   // Invoked by KiUserEmulationDispatcher after e.g. an NtContinue to x86 code
 .global BeginSimulation
 BeginSimulation:
-  ldr x17, [x18, #0x1788] // TEB->ChpeV2CpuAreaInfo
+  LOAD_TEB x17
+  ldr x17, [x17, #0x1788] // TEB->ChpeV2CpuAreaInfo
   ldr x16, [x17, #0x8] // ChpeV2CpuAreaInfo->EmulatorStackBase
   mov sp, x16
   ldr x0, [x17, #0x18] // ChpeV2CpuAreaInfo->ContextAmd64
   bl "#SyncThreadContext"
-  ldr x17, [x18, #0x1788] // TEB->ChpeV2CpuAreaInfo
+  LOAD_TEB x17
+  ldr x17, [x17, #0x1788] // TEB->ChpeV2CpuAreaInfo
   ldr x16, [x17, #0x48] // ChpeV2CpuAreaInfo->EmulatorData[3] - DispatcherLoopTopEnterECFillSRA
   mov x11, #0 // Zero ENTRY_FILL_SRA_SINGLE_INST_REG to avoid single step
   br x16 // DispatcherLoopTopEnterECFillSRA(SingleInst:x10, CPUArea:x17)
@@ -59,7 +76,8 @@ ExitFunctionEC:
   mrs x17, fpcr
   and x17, x17, #~6 // NEP + AH
   msr fpcr, x17
-  ldr x17, [x18, #0x1788] // TEB->ChpeV2CpuAreaInfo
+  LOAD_TEB x17
+  ldr x17, [x17, #0x1788] // TEB->ChpeV2CpuAreaInfo
   strb wzr, [x17, #0x0] // ChpeV2CpuAreaInfo->InSimulation
   ldr x17, [x17, #0x20] // ChpeV2CpuAreaInfo->SuspendDoorbell
   ldr w17, [x17]
