index 79a0068..ee166af 100644
--- a/Source/Windows/Common/CRT/Misc.cpp
+++ b/Source/Windows/Common/CRT/Misc.cpp
@@ -2,6 +2,7 @@
 #define _SECIMP
 #define _CRTIMP
 #include <cstdlib>
+#include "../CurrentTEB.h"
 #include <cstdint>
 #include <unistd.h>
 #include <wchar.h>
@@ -18,7 +19,7 @@ char** EnvArray;
 namespace {
 void InitEnv() {
   RtlAcquirePebLock();
-  auto ProcessParams = reinterpret_cast<RTL_USER_PROCESS_PARAMETERS64*>(NtCurrentTeb()->ProcessEnvironmentBlock->ProcessParameters);
+  auto ProcessParams = reinterpret_cast<RTL_USER_PROCESS_PARAMETERS64*>(RawCurrentTeb()->ProcessEnvironmentBlock->ProcessParameters);
   wchar_t* EnvW = reinterpret_cast<wchar_t*>(ProcessParams->Environment);
   DWORD SizeW = 4;
