 #include <winternl.h>
+#include "CurrentTEB.h"
 
 static inline __TEB* GetCurrentTEB() {
-  return reinterpret_cast<__TEB*>(NtCurrentTeb());
+  return reinterpret_cast<__TEB*>(RawCurrentTeb());
 }
 
 static inline __PEB* GetCurrentPEB() {
