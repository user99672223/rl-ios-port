 .../Interface/Core/Dispatcher/Dispatcher.cpp  |   6 +-
 FEXCore/Source/Interface/Core/JIT/MiscOps.cpp |   4 +-
 FEXCore/Source/Utils/CodeMemory.cpp           | 199 ++++++++++++++++++
 FEXCore/include/FEXCore/Utils/CodeMemory.h    |  70 ++++++
 Source/Windows/ARM64EC/Module.S               |  28 ++-
 Source/Windows/ARM64EC/Module.cpp             |   7 +-
 Source/Windows/Common/CRT/Misc.cpp            |   3 +-
 Source/Windows/Common/CurrentTEB.h            |  16 ++
 Source/Windows/Common/Priv.h                  |   3 +-
 10 files changed, 334 insertions(+), 15 deletions(-)
 create mode 100644 FEXCore/Source/Utils/CodeMemory.cpp
 create mode 100644 FEXCore/include/FEXCore/Utils/CodeMemory.h
