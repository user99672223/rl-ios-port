diff --git a/FEXCore/Source/Utils/CodeMemory.cpp b/FEXCore/Source/Utils/CodeMemory.cpp
new file mode 100644
index 0000000..bc5e1a8
--- /dev/null
+++ b/FEXCore/Source/Utils/CodeMemory.cpp
@@ -0,0 +1,199 @@
+// SPDX-License-Identifier: MIT
+#include <FEXCore/Utils/AllocatorHooks.h>
+#include <FEXCore/Utils/CodeMemory.h>
+#include <FEXCore/Utils/LogManager.h>
+
+#include <atomic>
+#include <cstdlib>
+#include <cstring>
+
+#ifndef _WIN32
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
+
+namespace FEXCore::Allocator {
+
+const CodeMemoryHooks* ActiveCodeMemoryHooks {};
+
+#ifndef _WIN32
+namespace {
+  // Test mode: each allocation is a memfd mapped twice. The RX view can never be written and the
+  // RW view can never be executed, so any code write that bypasses the RW alias faults.
+  struct SplitEntry {
+    std::atomic<uintptr_t> RXBase {0};
+    size_t Size {};
+    intptr_t RWMinusRX {};
+  };
+  constexpr size_t MaxSplitEntries = 1024;
+  SplitEntry SplitEntries[MaxSplitEntries];
+  std::atomic_flag SplitLock = ATOMIC_FLAG_INIT;
+
+  struct SplitGuard {
+    SplitGuard() {
+      while (SplitLock.test_and_set(std::memory_order_acquire)) {}
+    }
+    ~SplitGuard() {
+      SplitLock.clear(std::memory_order_release);
+    }
+  };
+
+  bool SplitAllocate(size_t Size, CodeMemory* Out) {
+    int FD = memfd_create("fex-splitwx", MFD_CLOEXEC);
+    if (FD == -1) {
+      return false;
+    }
+    if (ftruncate(FD, Size) != 0) {
+      close(FD);
+      return false;
+    }
+    void* RW = FEXCore::Allocator::mmap(nullptr, Size, PROT_READ | PROT_WRITE, MAP_SHARED, FD, 0);
+    if (RW == MAP_FAILED) {
+      close(FD);
+      return false;
+    }
+    void* RX = FEXCore::Allocator::mmap(nullptr, Size, PROT_READ | PROT_EXEC, MAP_SHARED, FD, 0);
+    close(FD);
+    if (RX == MAP_FAILED) {
+      FEXCore::Allocator::munmap(RW, Size);
+      return false;
+    }
+
+    SplitGuard lk;
+    for (auto& Entry : SplitEntries) {
+      if (Entry.RXBase.load(std::memory_order_relaxed) == 0) {
+        Entry.Size = Size;
+        Entry.RWMinusRX = reinterpret_cast<intptr_t>(RW) - reinterpret_cast<intptr_t>(RX);
+        Entry.RXBase.store(reinterpret_cast<uintptr_t>(RX), std::memory_order_release);
+        Out->RX = RX;
+        Out->RW = RW;
+        return true;
+      }
+    }
+    FEXCore::Allocator::munmap(RW, Size);
+    FEXCore::Allocator::munmap(RX, Size);
+    return false;
+  }
+
+  void SplitFree(void* RX, size_t Size) {
+    intptr_t Delta = 0;
+    {
+      SplitGuard lk;
+      for (auto& Entry : SplitEntries) {
+        if (Entry.RXBase.load(std::memory_order_relaxed) == reinterpret_cast<uintptr_t>(RX)) {
+          Delta = Entry.RWMinusRX;
+          Entry.RXBase.store(0, std::memory_order_release);
+          break;
+        }
+      }
+    }
+    FEXCore::Allocator::munmap(reinterpret_cast<void*>(reinterpret_cast<intptr_t>(RX) + Delta), Size);
+    FEXCore::Allocator::munmap(RX, Size);
+  }
+
+  void* SplitToRW(const void* RX) {
+    const auto Addr = reinterpret_cast<uintptr_t>(RX);
+    for (const auto& Entry : SplitEntries) {
+      const auto Base = Entry.RXBase.load(std::memory_order_acquire);
+      if (Base && Addr - Base < Entry.Size) {
+        return reinterpret_cast<void*>(static_cast<intptr_t>(Addr) + Entry.RWMinusRX);
+      }
+    }
+    // Not code memory (for example an address on a stack): there is no RW alias.
+    return const_cast<void*>(RX);
+  }
+
+  const CodeMemoryHooks SplitTestHooks {
+    .Allocate = SplitAllocate,
+    .Free = SplitFree,
+    .ToRW = SplitToRW,
+    .Flush = nullptr,
+  };
+
+  void MaybeEnableTestMode() {
+    static const bool Once = [] {
+      const char* Env = getenv("FEX_TEST_SPLITWX");
+      if (!ActiveCodeMemoryHooks && Env && Env[0] != '\0' && Env[0] != '0') {
+        ActiveCodeMemoryHooks = &SplitTestHooks;
+      }
+      return true;
+    }();
+    (void)Once;
+  }
+} // namespace
+#else
+namespace {
+  void MaybeEnableTestMode() {}
+} // namespace
+#endif
+
+void SetCodeMemoryHooks(const CodeMemoryHooks* Hooks) {
+  ActiveCodeMemoryHooks = Hooks;
+}
+
+CodeMemory AllocateCodeMemory(size_t Size) {
+  MaybeEnableTestMode();
+  if (const auto* Hooks = ActiveCodeMemoryHooks) {
+    CodeMemory Result {};
+    if (!Hooks->Allocate(Size, &Result)) {
+      return {};
+    }
+    return Result;
+  }
+  void* Ptr = FEXCore::Allocator::VirtualAlloc(Size, true);
+#ifndef _WIN32
+  if (Ptr == MAP_FAILED) {
+    Ptr = nullptr;
+  }
+#endif
+  return {Ptr, Ptr};
+}
+
+void FreeCodeMemory(void* RX, size_t Size) {
+  if (const auto* Hooks = ActiveCodeMemoryHooks) {
+    Hooks->Free(RX, Size);
+  } else {
+    FEXCore::Allocator::VirtualFree(RX, Size);
+  }
+}
+
+#if defined(__aarch64__) && !defined(_WIN32)
+static void SplitFlushARM64(uintptr_t RW, uintptr_t RX, size_t Size) {
+  uint64_t CTR;
+  asm volatile("mrs %0, ctr_el0" : "=r"(CTR));
+  const size_t DLine = 4U << ((CTR >> 16) & 0xF);
+  const size_t ILine = 4U << (CTR & 0xF);
+  // CTR_EL0.IDC: no data cache clean needed for instruction-to-data coherence.
+  if (!(CTR & (1U << 28))) {
+    for (uintptr_t A = RW & ~(DLine - 1); A < RW + Size; A += DLine) {
+      asm volatile("dc cvau, %0" ::"r"(A) : "memory");
+    }
+  }
+  asm volatile("dsb ish" ::: "memory");
+  // CTR_EL0.DIC: no instruction cache invalidate needed.
+  if (!(CTR & (1U << 29))) {
+    for (uintptr_t A = RX & ~(ILine - 1); A < RX + Size; A += ILine) {
+      asm volatile("ic ivau, %0" ::"r"(A) : "memory");
+    }
+    asm volatile("dsb ish" ::: "memory");
+  }
+  asm volatile("isb" ::: "memory");
+}
+#endif
+
+void FlushCodeMemory(const void* RX, size_t Size) {
+  if (const auto* Hooks = ActiveCodeMemoryHooks) {
+    if (Hooks->Flush) {
+      Hooks->Flush(const_cast<void*>(RX), Size);
+      return;
+    }
+#if defined(__aarch64__) && !defined(_WIN32)
+    SplitFlushARM64(reinterpret_cast<uintptr_t>(Hooks->ToRW(RX)), reinterpret_cast<uintptr_t>(RX), Size);
+    return;
+#endif
+  }
+  __builtin___clear_cache(const_cast<char*>(static_cast<const char*>(RX)), const_cast<char*>(static_cast<const char*>(RX)) + Size);
+}
+
+} // namespace FEXCore::Allocator
diff --git a/FEXCore/include/FEXCore/Utils/CodeMemory.h b/FEXCore/include/FEXCore/Utils/CodeMemory.h
new file mode 100644
index 0000000..4eb4550
--- /dev/null
+++ b/FEXCore/include/FEXCore/Utils/CodeMemory.h
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <FEXCore/Utils/CompilerDefs.h>
+
+#include <cstddef>
+#include <cstdint>
+
+// Executable memory for FEX's JIT, with an optional write-xor-execute split.
+//
+// By default code memory is a single RWX mapping and the "RW" and "RX" views below are the same
+// address (upstream behaviour). A host that cannot create RWX mappings (iOS, MDWE) installs
+// CodeMemoryHooks. Each allocation then has two views of the same bytes:
+//   RX: the address generated code executes from. Every address that ends up in generated code
+//       or in FEX data structures (branch targets, return addresses, lookup cache entries,
+//       block link records, literals, signal PCs) is an RX address.
+//   RW: an alias that is only ever written through, and never executed.
+// RX and RW differ by a constant per allocation, so `rw = rx + diff` for any byte inside it.
+//
+// Linux test mode: `FEX_TEST_SPLITWX=1` in the environment makes FEX install hooks that back every
+// code allocation with a memfd mapped twice (RX view read+exec only, RW view read+write only), so
+// that a write through an RX address, or an instruction fetch from an RW address, faults at once.
+namespace FEXCore::Allocator {
+
+struct CodeMemory {
+  void* RX {};
+  void* RW {};
+};
+
+struct CodeMemoryHooks {
+  // Allocate `Size` bytes (a multiple of the page size) of zero-filled code memory.
+  // Fills `Out` with both views and returns true, or returns false on failure.
+  bool (*Allocate)(size_t Size, CodeMemory* Out);
+  // Release an allocation returned by Allocate. `RX` is the RX base given back by Allocate.
+  void (*Free)(void* RX, size_t Size);
+  // Translate any address inside a live allocation from its RX view to its RW view.
+  // Must be lock free and async-signal-safe: it is used from signal handlers.
+  void* (*ToRW)(const void* RX);
+  // Optional. Make bytes written through the RW view visible to instruction fetch at RX.
+  // Defaults to `dc cvau` on the RW view and `ic ivau` on the RX view (ARM64).
+  void (*Flush)(void* RX, size_t Size);
+};
+
+// The hooks in use, or nullptr for the default single RWX mapping.
+FEX_DEFAULT_VISIBILITY extern const CodeMemoryHooks* ActiveCodeMemoryHooks;
+
+// Install hooks (nullptr restores the default). Must happen before the first code allocation
+// and must outlive every allocation made through it.
+FEX_DEFAULT_VISIBILITY void SetCodeMemoryHooks(const CodeMemoryHooks* Hooks);
+
+// True when RX and RW are different mappings.
+inline bool IsCodeMemorySplit() {
+  return ActiveCodeMemoryHooks != nullptr;
+}
+
+// Allocate code memory. {nullptr, nullptr} on failure.
+FEX_DEFAULT_VISIBILITY CodeMemory AllocateCodeMemory(size_t Size);
+FEX_DEFAULT_VISIBILITY void FreeCodeMemory(void* RX, size_t Size);
+
+// RX -> RW. Identity when no hooks are installed.
+template<typename T>
+inline T* CodeMemoryToRW(T* RX) {
+  const auto* Hooks = ActiveCodeMemoryHooks;
+  return Hooks ? static_cast<T*>(Hooks->ToRW(RX)) : RX;
+}
+
+// Instruction cache maintenance for [RX, RX + Size) after it was written through the RW view.
+// Uses the RX address for the instruction cache and the RW address for the data cache clean.
+FEX_DEFAULT_VISIBILITY void FlushCodeMemory(const void* RX, size_t Size);
+
+} // namespace FEXCore::Allocator
