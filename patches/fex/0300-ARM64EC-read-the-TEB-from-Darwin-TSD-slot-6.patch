diff --git a/Source/Windows/Common/CurrentTEB.h b/Source/Windows/Common/CurrentTEB.h
new file mode 100644
index 0000000..bb51dbd
--- /dev/null
+++ b/Source/Windows/Common/CurrentTEB.h
@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <winternl.h>
+
+// What NtCurrentTeb() returns. mingw's NtCurrentTeb() reads x18 on ARM64/ARM64EC; with
+// FEX_TEB_IN_DARWIN_TSD (Wine on Apple ARM64, where the kernel does not preserve x18) the TEB is read
+// from pthread TSD slot 6 (TPIDRRO_EL0 + 0x30), which Wine keeps current for every thread.
+inline struct _TEB* RawCurrentTeb() {
+#if defined(FEX_TEB_IN_DARWIN_TSD) && defined(_M_ARM64EC)
+  struct _TEB** TSD;
+  __asm__("mrs %0, tpidrro_el0" : "=r"(TSD));
+  return TSD[6];
+#else
+  return NtCurrentTeb();
+#endif
+}
