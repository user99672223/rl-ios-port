From d968e7318328a53b4615d043a42c0c93c5637df5 Mon Sep 17 00:00:00 2001
From: splitwx <splitwx@local>
Date: Thu, 29 Oct 2026 06:42:00 +0100
Subject: [PATCH 206/206] CodeCache: split-aware cache load, finalize, store
 and validate

---
 FEXCore/Source/Interface/Core/CodeCache.cpp | 63 ++++++++++++++++-----
 FEXCore/include/FEXCore/Core/CodeCache.h    |  6 ++
 2 files changed, 54 insertions(+), 15 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/CodeCache.cpp b/FEXCore/Source/Interface/Core/CodeCache.cpp
index 87a110c..fb804d0 100644
--- a/FEXCore/Source/Interface/Core/CodeCache.cpp
+++ b/FEXCore/Source/Interface/Core/CodeCache.cpp
@@ -29,6 +29,7 @@
 #include <xxhash.h>
 
 #include <FEXCore/Utils/AllocatorHooks.h>
+#include <FEXCore/Utils/CodeMemory.h>
 
 #include <fstream>
 
@@ -48,7 +49,9 @@ MappedCodeCacheFile::~MappedCodeCacheFile() {
   }
 
 #ifndef _WIN32
-  if (!CodeBuffer.empty()) {
+  if (!CodeBufferWritable.empty()) {
+    FEXCore::Allocator::FreeCodeMemory(CodeBuffer.data(), CodeBuffer.size_bytes());
+  } else if (!CodeBuffer.empty()) {
     FEXCore::Allocator::munmap(CodeBuffer.data(), CodeBuffer.size_bytes());
   }
 #elif defined(_M_ARM64EC)
@@ -352,8 +355,9 @@ bool CodeCache::SaveData(Core::InternalThreadState& Thread, int fd, const Execut
   }
 
   // Dump the host code (relocated for position-independent serialization)
-  std::span CodeBufferData(reinterpret_cast<std::byte*>(CodeBuffer->GetBufferBase()),
-                           reinterpret_cast<std::byte*>(CodeBuffer->GetBufferBase()) + CodeBuffer->AllocatedSpaceUsed());
+  // Relocations are applied in place, so this has to be the writable alias of the code buffer.
+  std::span CodeBufferData(reinterpret_cast<std::byte*>(CodeBuffer->GetBufferBaseWritable()),
+                           reinterpret_cast<std::byte*>(CodeBuffer->GetBufferBaseWritable()) + CodeBuffer->AllocatedSpaceUsed());
   if (!ApplyCodeRelocations(SerializedBaseAddress, CodeBufferData, Relocations, true)) {
     LOGMAN_THROW_A_FMT(false, "Failed to apply code relocations");
     return false;
@@ -422,7 +426,7 @@ void CodeCache::Validate(const ExecutableFileSectionInfo& Section, fextl::set<ui
   }
 
   std::span<std::byte> CodeBufferRangeRef =
-    std::as_writable_bytes(std::span {NewCodeBuffer->GetBufferBase(), NewCodeBuffer->GetBufferBase() + NewCodeBuffer->UsableSize()})
+    std::as_writable_bytes(std::span {NewCodeBuffer->GetBufferBaseWritable(), NewCodeBuffer->GetBufferBaseWritable() + NewCodeBuffer->UsableSize()})
       .subspan(0, CachedCode.size_bytes());
 
   while (!GuestBlocks.empty()) {
@@ -699,16 +703,30 @@ CodeCache::LoadCache(std::span<std::byte> CacheFile, const ExecutableFileInfo& F
   Cursor = reinterpret_cast<std::byte*>(AlignUp(reinterpret_cast<uintptr_t>(Cursor), Utils::FEX_PAGE_SIZE));
   auto CodeDataInFile = std::span {Cursor, header.CodeBufferSize};
 
+  std::span<std::byte> CodeBufferWritable {};
 #ifndef _WIN32
-  // Allocate target memory for post-relocation code. This is PROT_NONE until
-  // the first execution, so that contents can be lazily populated in a
-  // frontend-provided segfault handler.
-  void* CodeBufferAllocation = Allocator::mmap(nullptr, header.CodeBufferSize, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
-  if (CodeBufferAllocation == MAP_FAILED) {
-    LogMan::Msg::EFmt("Failed to reserve target memory for code cache");
-    return nullptr;
+  std::span<std::byte> CodeBuffer;
+  if (Allocator::IsCodeMemorySplit()) {
+    // Split code memory: execute from the RX view and write through the RW alias. There is no
+    // PROT_NONE placeholder to fault on, so the code is finalized eagerly (see EnableLoadedSection).
+    const auto Memory = Allocator::AllocateCodeMemory(header.CodeBufferSize);
+    if (!Memory.RX) {
+      LogMan::Msg::EFmt("Failed to allocate code cache memory");
+      return nullptr;
+    }
+    CodeBuffer = std::span {static_cast<std::byte*>(Memory.RX), header.CodeBufferSize};
+    CodeBufferWritable = std::span {static_cast<std::byte*>(Memory.RW), header.CodeBufferSize};
+  } else {
+    // Allocate target memory for post-relocation code. This is PROT_NONE until
+    // the first execution, so that contents can be lazily populated in a
+    // frontend-provided segfault handler.
+    void* CodeBufferAllocation = Allocator::mmap(nullptr, header.CodeBufferSize, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (CodeBufferAllocation == MAP_FAILED) {
+      LogMan::Msg::EFmt("Failed to reserve target memory for code cache");
+      return nullptr;
+    }
+    CodeBuffer = std::span {static_cast<std::byte*>(CodeBufferAllocation), header.CodeBufferSize};
   }
-  auto CodeBuffer = std::span {static_cast<std::byte*>(CodeBufferAllocation), header.CodeBufferSize};
 #elif defined(_M_ARM64EC)
   // TODO: Implement lazy mapping on Windows
   // NOTE: The executed code must have MEM_EXTENDED_PARAMETER_EC_CODE set, so we can't operate on the mapped cache file directly
@@ -737,9 +755,11 @@ CodeCache::LoadCache(std::span<std::byte> CacheFile, const ExecutableFileInfo& F
   }
 
   auto Storage = FEXCore::Allocator::aligned_alloc(alignof(MappedCodeCacheFile), sizeof(MappedCodeCacheFile));
-  return fextl::unique_ptr<MappedCodeCacheFile>(
+  auto Result = fextl::unique_ptr<MappedCodeCacheFile>(
     new (Storage) MappedCodeCacheFile {this, CacheFile, CodeDataInFile, CodeBuffer, BlockListStart, header.NumBlocks, header.NumCodePages,
                                        std::move(PageRelocationRanges), fextl::vector<bool>(NumPages), FileStartVA});
+  Result->CodeBufferWritable = CodeBufferWritable;
+  return Result;
 }
 
 bool CodeCache::EnableLoadedSection(Core::InternalThreadState* Thread, MappedCodeCacheFile& Code, const ExecutableFileSectionInfo& BinarySection) {
@@ -838,7 +858,7 @@ bool CodeCache::EnableLoadedSection(Core::InternalThreadState* Thread, MappedCod
   }
 
 #ifndef _WIN32
-  if (!EnableLazyCodeCaching || EnableCodeCacheValidation) {
+  if (!EnableLazyCodeCaching || EnableCodeCacheValidation || !Code.CodeBufferWritable.empty()) {
 #else
   // TODO: Implement lazy mapping on Windows
   if (true) {
@@ -944,6 +964,19 @@ void CodeCache::FinalizeCodePages(MappedCodeCacheFile& Code, std::span<std::byte
   FEXCORE_PROFILE_SCOPED("FinalizeCodePages");
 
 #ifndef _WIN32
+  if (!Code.CodeBufferWritable.empty()) {
+    // Split code memory: populate and relocate through the RW alias (like the ARM64EC path below).
+    // The RX view is only ever read and executed.
+    memcpy(Code.CodeBufferWritable.data() + StartOffset, Code.CodeBufferInFile.data() + StartOffset, Size);
+    for (size_t i = StartPage; i < EndPage; ++i) {
+      auto PageRelocations = SpanPageRelocations(Code, i);
+      (void)ApplyCodeRelocations(Code.GuestBase, Code.CodeBufferWritable, PageRelocations, false);
+      Code.LoadedPages[i] = true;
+    }
+    FEXCore::Allocator::FlushCodeMemory(CodeRange.data(), Size);
+    return;
+  }
+
   // Atomicity is critical when making the finalized code data visible.
   // We ensure this by remapping a temporary buffer onto the PROT_NONE
   // placeholder page in CodeBuffer. Some constraints to keep in mind are:
@@ -998,7 +1031,7 @@ void CodeCache::FinalizeCodePages(MappedCodeCacheFile& Code, std::span<std::byte
   }
 #endif
 
-  ARMEmitter::Emitter::ClearICache(CodeRange.data(), Size);
+  FEXCore::Allocator::FlushCodeMemory(CodeRange.data(), Size);
 }
 
 } // namespace FEXCore::Context
diff --git a/FEXCore/include/FEXCore/Core/CodeCache.h b/FEXCore/include/FEXCore/Core/CodeCache.h
index a09c574..43a3210 100644
--- a/FEXCore/include/FEXCore/Core/CodeCache.h
+++ b/FEXCore/include/FEXCore/Core/CodeCache.h
@@ -221,6 +221,12 @@ struct MappedCodeCacheFile {
 
   uint64_t GuestBase {}; // Guest base address for relocation application
 
+  // Writable alias of CodeBuffer when code memory is split into separate RW and RX views
+  // (see FEXCore/Utils/CodeMemory.h). Empty otherwise. In that case CodeBuffer is the RX view,
+  // the code is finalized eagerly (there is no lazily faulted PROT_NONE placeholder), and it is
+  // released with FreeCodeMemory.
+  std::span<std::byte> CodeBufferWritable {};
+
   // Helper member to prevent moving/copying without disallowing aggregate-construction
   std::atomic<int> disallow_copy_or_move;
 
